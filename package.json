{
  "name": "fire-monitoring-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:dashboard": "pnpm --filter @fire-monitoring/monitoring-dashboard dev",
    "dev:camera-web": "pnpm --filter @fire-monitoring/camera-web dev",
    "build": "pnpm --filter @fire-monitoring/shared build && pnpm --filter @fire-monitoring/monitoring-dashboard build && pnpm --filter @fire-monitoring/camera-web build",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm -r run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.8.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}